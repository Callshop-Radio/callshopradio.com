NUXT_SANITY_PROJECT_ID=abcde123
NUXT_SANITY_DATASET=production
NUXT_SANITY_API_READ_TOKEN=xxx
NUXT_SANITY_STUDIO_URL=http://localhost:3333
NUXT_GTAG_ID=G-xxxxxxxxxx

# LibreTime API Key for live streaming data
NUXT_LIBRETIME_API_KEY=your-libretime-api-key-here

# Cache Revalidation Webhook Secret (from Sanity Dashboard)
SANITY_WEBHOOK_SECRET=your-sanity-webhook-secret-here

# Listener accounts (BFF). The manager base URL is server-only.
NUXT_MANAGER_BASE_URL=https://air.callshopradio.live
NUXT_ACCOUNT_CLIENT_SECRET=CHANGE_ME_SHARED_WITH_THE_MANAGER
NUXT_ACCOUNT_IP_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS
# Comma-separated write origins; no wildcards.
NUXT_ACCOUNT_ALLOWED_ORIGINS=https://callshopradio.com,https://www.callshopradio.com
# Local development only: enables the fixed 127.0.0.1 fallback for login IPs.
# NUXT_ACCOUNT_DEV_MODE=1