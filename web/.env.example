NUXT_SANITY_PROJECT_ID=abcde123
NUXT_SANITY_DATASET=production
NUXT_SANITY_API_READ_TOKEN=xxx
NUXT_SANITY_STUDIO_URL=http://localhost:3333

# Self-hosted Umami (script is loaded only after analytics consent)
NUXT_PUBLIC_UMAMI_HOST=https://stats.example.com
NUXT_PUBLIC_UMAMI_ID=00000000-0000-0000-0000-000000000000
# Comma-separated production hostnames; localhost is intentionally excluded
NUXT_PUBLIC_UMAMI_DOMAINS=callshopradio.com,www.callshopradio.com

# LibreTime API Key for live streaming data
NUXT_LIBRETIME_API_KEY=your-libretime-api-key-here

# SoundCloud API client id (server-only; used for the set waveform image).
NUXT_SOUNDCLOUD_CLIENT_ID=
# SoundCloud API client secret (server-only; exchanged for a client_credentials token).
NUXT_SOUNDCLOUD_CLIENT_SECRET=

# Cache Revalidation Webhook Secret (from Sanity Dashboard)
SANITY_WEBHOOK_SECRET=your-sanity-webhook-secret-here
