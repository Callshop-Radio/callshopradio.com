.default {
  display: flex;
  flex-flow: column wrap;
  justify-content: flex-start;
  align-items: center;
  width: 100%;
  max-width: var(--page-max-width);
  &__content {
    width: 100%;
    padding: var(--big-margin) var(--base-padding) var(--content-gap)
      var(--base-padding);
    gap: var(--content-gap) 0;
  }
}

.module-section {
  width: 100%;
  display: flex;
  flex-flow: column wrap;
  justify-content: flex-start;
  align-items: center;
  gap: var(--content-gap) 0;
  @media screen and (max-width: 900px) {
    max-height: max-content;
  }
  .module {
    width: 100%;
    max-width: var(--page-max-width);
    &:first-of-type {
      /* margin-top: var(--big-margin); */
      margin-top: var(--first-content-distance);
      @media screen and (max-width: 900px) {
        margin-top: var(--base-margin);
      }
    }
    &:last-of-type {
      margin-bottom: var(--content-gap);
    }
    .module-carousel {
      &.pool {
        .module-carousel__header__type__pill {
          --pill-accent: var(--color-blue);
        }
        .city-tags {
          .tag {
            background-color: var(--color-blue);
          }
        }
        .embla__nav__dots {
          .embla__dot {
            &.is-selected {
              background-color: var(--color-blue);
            }

            &:hover {
              @media (min-width: 1024px) {
                background-color: var(--color-blue);
              }
            }
          }
        }
        .slide-date {
          display: none;
        }
      }

      &.words {
        .module-carousel__header__type__pill {
          --pill-accent: var(--color-green);
        }
        .city-tags {
          .tag {
            background-color: var(--color-green);
          }
        }
        .embla__nav__dots {
          .embla__dot {
            &.is-selected {
              background-color: var(--color-green);
            }

            &:hover {
              @media (min-width: 1024px) {
                background-color: var(--color-green);
              }
            }
          }
        }
        .slide-content {
          width: calc(100% - 62.75%);
          padding: 0 0 0 var(--big-margin);
          .slide-date {
            display: none;
          }
          .slide-title {
            font-size: var(--large-font-size);
            text-transform: none !important;
          }
        }
      }

      &.shows,
      &.episodes,
      &.sets {
        .module-carousel__header__type__pill,
        .module-teaser__header__type__pill {
          --pill-accent: var(--color-pink);
        }
        .city-tags {
          .tag {
            font-size: var(--mini-font-size);
          }
        }
        .embla__nav__dots {
          .embla__dot {
            &.is-selected {
              background-color: var(--color-pink);
            }

            &:hover {
              @media (min-width: 1024px) {
                background-color: var(--color-pink);
              }
            }
          }
        }
      }

      &__header {
        @media screen and (max-width: 900px) {
          /* padding: 0 var(--big-margin); */
          margin: 0 !important;
        }
        &__type {
          @apply flex;
          justify-content: flex-end;
          @media screen and (max-width: 900px) {
            justify-content: flex-start;
            position: absolute;
            pointer-events: none;
          }
          a {
            &:hover {
              @media (min-width: 1024px) {
                text-decoration: none;
              }
            }
          }
          &__pill {
            @apply uppercase rounded-full;
            font-size: var(--base-font-size);
            padding: var(--small-padding) var(--base-padding);
            min-width: 8.5rem;
            max-width: max-content;
            text-align: center;
            color: var(--pill-accent, var(--color-text));
            background-color: transparent;
            border: 0.09325rem solid var(--pill-accent, var(--color-text));
            transition:
              background-color 0.2s ease,
              color 0.2s ease;

            &:hover {
              background-color: var(--pill-accent, var(--color-text));
              color: var(--color-white);
            }
          }
        }
      }
      &__header,
      .embla__nav {
        margin: 0 0 var(--base-margin) 0;
      }
      &__title {
      }
    }
    .module-teaser {
      &.words {
        --load-more-accent: var(--color-green);

        .module-teaser__header__type__pill {
          --pill-accent: var(--color-green);
        }
        .city-tags {
          .tag {
            background-color: var(--color-green);
          }
        }
        .embla__nav__dots {
          .embla__dot {
            &.is-selected {
              background-color: var(--color-green);
            }

            &:hover {
              @media (min-width: 1024px) {
                background-color: var(--color-green);
              }
            }
          }
        }
        .slide-date {
          display: none;
        }
      }
      &.pool {
        --load-more-accent: var(--color-blue);

        .module-teaser__header__type__pill {
          --pill-accent: var(--color-blue);
        }
        .city-tags {
          .tag {
            background-color: var(--color-blue);
          }
        }
        .embla__nav__dots {
          .embla__dot {
            &.is-selected {
              background-color: var(--color-blue);
            }

            &:hover {
              @media (min-width: 1024px) {
                background-color: var(--color-blue);
              }
            }
          }
        }
        .slide-date {
          display: none;
        }
      }
      &.shows,
      &.episodes,
      &.sets {
        --load-more-accent: var(--color-pink);

        .module-teaser__header__type__pill {
          --pill-accent: var(--color-pink);
        }
        .city-tags {
          .tag {
            font-size: var(--mini-font-size);
          }
        }
        .embla__nav__dots {
          .embla__dot {
            &.is-selected {
              background-color: var(--color-pink);
            }

            &:hover {
              @media (min-width: 1024px) {
                background-color: var(--color-pink);
              }
            }
          }
        }
      }
      &__header {
        &__type {
          display: flex;
          flex-flow: row wrap;
          justify-content: space-between;
          align-items: center;
          margin: 0 0 var(--big-margin);
          &__pill {
            @apply uppercase rounded-full;
            font-size: var(--base-font-size);
            font-family: var(--font-text-semibold);
            padding: var(--small-padding) var(--big-padding);
            max-width: max-content;
            text-align: center;
            color: var(--pill-accent, var(--color-text));
            background-color: transparent;
            border: 0.09325rem solid var(--pill-accent, var(--color-text));
            transition:
              background-color 0.2s ease,
              color 0.2s ease;

            &:hover {
              background-color: var(--pill-accent, var(--color-text));
              color: var(--color-white);
              text-decoration: none;
            }
          }
        }
      }
    }
  }
}

.content-grid,
.related-content {
  &.shows,
  &.episodes,
  &.sets {
    .city-tags {
      .tag.city {
        background-color: var(--color-pink);
      }
    }
  }
  &.pool {
    .city-tags {
      .tag.city {
        background-color: var(--color-blue);
      }
    }
  }
  &.words {
    .city-tags {
      .tag.city {
        background-color: var(--color-green);
        color: var(--color-white);
        border-color: var(--color-green);
      }
    }
  }
}

/* Load-more: a quiet outlined circle in the section accent. It fills on hover
   and the plus turns 90°. The text variant ("More") becomes an outlined pill. */
.load-more-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--small-padding);
  width: 2.75rem;
  height: 2.75rem;
  padding: 0;
  border: 0.09325rem solid var(--load-more-accent, var(--color-pink));
  border-radius: 50%;
  background-color: transparent;
  color: var(--load-more-accent, var(--color-pink));
  box-shadow: none;
  cursor: pointer;
  font-family: var(--font-text-semibold);
  font-size: var(--small-font-size);
  text-transform: uppercase;
  letter-spacing: var(--button-letter-spacing);
  transition:
    background-color var(--transition-fast),
    color var(--transition-fast),
    border-color var(--transition-fast);

  svg {
    flex: none;
    width: 0.8rem;
    height: 0.8rem;
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);

    path {
      stroke: currentColor;
    }
  }

  &:hover {
    background-color: var(--load-more-accent, var(--color-pink));
    color: var(--color-white);

    svg {
      transform: rotate(90deg);
    }
  }

  &:focus-visible {
    outline: 2px solid var(--load-more-accent, var(--color-pink));
    outline-offset: 3px;
  }

  &.more {
    width: auto;
    height: auto;
    padding: var(--small-padding) var(--big-padding);
    border-radius: var(--pill-radius);
  }
}

.tags {
  &.slide__tags {
    display: flex;
    flex-flow: row wrap;
    justify-content: flex-start;
    align-items: flex-start;
    gap: var(--small-padding);
    margin: auto 0 0 0;
  }
  .tag {
    color: var(--color-bg);
    font-size: var(--small-font-size);
    font-family: var(--font-text);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: var(--button-letter-spacing);
    padding: calc(var(--small-padding) / 2) var(--base-padding);
    background-color: var(--color-text);
    border-radius: 100px;
    border: 0.09325rem solid var(--color-text);
  }
}

.mobile-slider {
  .city-tags {
    display: flex;
    flex-flow: row;
    justify-content: center;
    align-items: flex-end;
    text-transform: uppercase;
    @media screen and (max-width: 900px) {
      justify-content: flex-start;
      /* margin: 0 auto 0 var(--big-margin); */
    }
  }
}

.city-tags {
  display: flex;
  flex-flow: row;
  justify-content: center;
  align-items: flex-end;
  text-transform: uppercase;
  @media screen and (max-width: 900px) {
    justify-content: flex-start;
    margin: 0 auto 0 0;
  }
  height: var(--city-tag-height);
  gap: var(--small-padding);
  .tag {
    color: var(--color-white);
    background-color: var(--color-text);
    &.city {
      border-bottom-right-radius: 0;
      border-bottom-left-radius: 0;
      border-top-left-radius: 4px;
      border-top-right-radius: 4px;
      padding: calc(var(--small-padding) / 2) var(--mid-padding)
        calc(var(--small-padding) / 2) var(--mid-padding);
      font-size: var(--mini-font-size);
      line-height: 1;
    }
  }
}

/* Page-level accents for the shared load-more pill */
.pool-detail,
.pool-archive {
  .related-content .load-more-button,
  .content-grid .load-more-button {
    --load-more-accent: var(--color-blue);
  }
}

.set-detail,
.shows-archive {
  .related-content .load-more-button,
  .content-grid .load-more-button {
    --load-more-accent: var(--color-pink);
  }
}


/* Branded play button (public/icons/play-button.svg) */
.play-button {
  background-color: transparent !important;
  padding: 0 !important;
}

.play-button:hover {
  background-color: transparent !important;
}

.play-button > img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
  transition: transform 0.2s ease;
}

.play-button:hover > img {
  transform: scale(1.05);
}

.plyr__control--overlaid {
  width: 4rem !important;
  height: 4rem !important;
  padding: 0 !important;
  border-radius: 100px !important;
  box-shadow: none !important;
  background: transparent url("/icons/play-button.svg") center / contain no-repeat !important;
}

.plyr__control--overlaid svg {
  display: none !important;
}

@media screen and (max-width: 900px) {
  .plyr__control--overlaid {
    width: 3rem !important;
    height: 3rem !important;
  }
}

@media (prefers-reduced-motion: reduce) {
  .play-button > img {
    transition: none;
  }

  .play-button:hover > img {
    transform: none;
  }
}