:root {
  /* Font Families */
  --font-text: "Icona-Sans-Regular", system-ui, sans-serif;
  --font-text-medium: "Icona-Sans-Medium", system-ui, sans-serif;
  --font-text-semibold: "Icona-Sans-Semibold", system-ui, sans-serif;
  --font-text-italic: "Icona-Sans-Italic", system-ui, sans-serif;
  --font-text-medium-italic: "Icona-Sans-Medium-Italic", system-ui, sans-serif;

  /* Type scale: four sizes, one place. Every size on the site is one of
     these steps; see DESIGN.md. The phone block below only shrinks the top
     end. Display sizes (hero headlines, marquee) are a separate fluid tier
     and are not part of this scale. */
  --text-s: 0.625rem; /* 10px: tags, meta, labels */
  --text-m: 1rem; /* 16px: body, forms */
  --text-l: 1.25rem; /* 20px: card titles, headings */
  --text-xl: 1.5625rem; /* 25px: page titles */
  --text-xxl: 2.5rem; /* 40px: detail titles */
  --text-display: 5rem; /* 80px: section mastheads */
  /* Leading is 1.25 x the size, applied inline where a rule needs it. The
     navigation is the one exception and tightens to 1.2. */
  --menu-letter-spacing: 0.0625rem;
  --button-letter-spacing: 0.0425rem;
  --label-letter-spacing: 0.06em; /* uppercase labels and tags */
  --kicker-letter-spacing: 0.08em; /* editorial kickers */

  @media (--phone-only) {
    --text-m: 0.875rem; /* 14px */
    --text-l: 1.125rem; /* 18px */
    --text-xl: 1.375rem; /* 22px */
    --text-xxl: 2rem; /* 32px */
    --text-display: 3rem; /* 48px */
  }

  /* Narrow phones collapse every heading into body size. */
  @media (--mini-phone-only) {
    --text-l: var(--text-m);
    --text-xl: var(--text-m);
  }
}

* {
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

a {
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-underline-offset: 0.125rem;
  text-decoration-thickness: 0.09375rem;
  text-decoration-color: var(--color-underline);
  &:hover {
    @media (min-width: 1024px) {
      text-decoration-color: var(--color-text);
    }
  }
}

html,
body {
  font-family: var(--font-text), system-ui, sans-serif;
  background-color: var(--color-bg);
  color: var(--color-text);
}

h1,
h2,
h3,
h4,
h5,
h6 {
  font-weight: 400;
}

h1 {
  font-size: var(--text-l);
  margin: 0;
}
h2 {
  font-size: var(--text-l);
}
h3 {
  font-size: var(--text-l);
}
h4,
h5,
h6 {
  font-size: var(--text-m);
}

p {
  font-size: var(--text-m);
  line-height: 1.25;
  & > * {
    font-size: var(--text-m);
    line-height: 1.25;
  }
}

strong,
b {
  /* The face is declared at 550; asking for the same value keeps the browser
     from synthesising a bold on top of it. */
  font-family: var(--font-text-semibold);
  font-weight: 550;
}

nav,
header,
nav a,
nav a h2 {
  font-size: var(--text-m);
  line-height: 1.2;
  & > * {
    font-size: var(--text-m);
    line-height: 1.2;
  }
}

button.link-style {
  all: unset;
}

a {
  cursor: pointer;
  color: var(--color-text);
  text-decoration: none;
  &.router-link-active {
    color: var(--color-link);
    /* text-decoration: underline; */
  }
}

p a {
  &:hover {
    @media (min-width: 1024px) {
      text-decoration-color: var(--color-text);
      text-decoration: underline;
    }
  }
}

code,
pre {
  font-family:
    "SF Mono", SFMono-Regular, ui-monospace, "DejaVu Sans Mono", Menlo,
    Consolas, monospace;
}

code {
  display: inline-block;
  background-color: var(--color-code-bg);
  border-radius: var(--radius-xs);
  white-space: pre;
}

em,
strong {
  font-size: inherit;
}

/* General Rich Text Styles */

.default,
.article-container {
  .rich-text {
    h1,
    h2 {
      font-size: var(--text-l);
      margin-bottom: var(--mid-margin);
      font-family: var(--font-text-medium);
    }

    h3,
    h4,
    h5 {
      margin: var(--base-margin) 0 var(--small-margin) 0;
      font-family: var(--font-text-medium);
    }

    a {
      text-decoration: underline;
    }

    p,
    a {
      /* Long-form body holds the 16 px step so articles keep their
         reading size even though h3 is 18 px. */
      font-size: var(--text-m);
      line-height: 1.25;
      margin: 0 0 var(--mid-margin);
      strong,
      s,
      em {
        font-size: inherit;
        line-height: inherit;
      }
    }

    /* Additive & Follow-Up Styles */
    p + .module-media {
      margin-top: var(--base-margin);
    }

    p + h2 {
      margin-top: var(--big-margin);
    }

    .module-media {
      display: flex;
      flex-flow: column;
      justify-content: flex-start;
      align-items: start;
      overflow: hidden;
      figure {
        display: flex;
        flex-flow: column;
        justify-content: flex-start;
        align-items: start;
        figcaption {
          font-size: var(--text-m);
          margin: var(--small-margin) 0 0 0;
        }
        img {
          align-self: flex-start;
          object-fit: contain;
          &.portrait {
            max-width: 50ch;
          }
          &.square {
            max-width: 60ch;
          }
        }
      }
    }
  }
}

/* Specific Rich Text Styles for Modules */

.module {
  .rich-text {
    h1,
    h2,
    h3 {
      font-size: var(--text-l);
    }

    h1,
    h2,
    h3,
    h4,
    h5,
    h6,
    p {
      &:first-child {
        margin-top: 0;
      }
    }

    h4,
    h5,
    h6 {
      font-size: var(--text-m);
    }

    h4 a,
    h5 a,
    h6 a,
    a h4,
    a h5,
    a h6 {
      display: block;
    }

    p {
      font-size: var(--text-m);
    }
  }
}

/* Words Editor Block Styles */

.rich-text {
  /* Inline marks: the manifest's italic styles are separate families, so the
     browser must not synthesise an oblique on top of them. */
  em {
    font-family: var(--font-text-italic);
    font-style: normal;
  }

  .rt-lead em,
  .rt-quote em {
    font-family: var(--font-text-medium-italic);
  }

  .rt-quote {
    margin: 2rem 0;
    max-width: 80ch;
    white-space: pre-wrap;
    font-family: var(--font-text-italic);
    font-size: var(--text-l);
    line-height: 1.5;
  }

  .rt-kicker {
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .rt-small {
    color: var(--color-dark-grey);
  }
}

.pool-text {
  &.rich-text {
    p {
      margin: 0 0 var(--base-padding);
    }
  }
}

